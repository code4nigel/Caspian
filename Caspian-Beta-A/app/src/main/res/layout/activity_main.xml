<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050811">

    <!-- 1. Full Screen Multi-WebView Browser Tab Container -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Overlay Control Sheet Container (Elevation 10dp) -->
    <FrameLayout
        android:id="@+id/sheet_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="10dp">

        <!-- Semi-transparent Backdrop -->
        <View
            android:id="@+id/sheet_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#77000000" />

        <!-- Control Sheet Overlay WebView -->
        <WebView
            android:id="@+id/control_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />
    </FrameLayout>

    <!-- 3. Native Circular Floating Wave Icon Button (Elevation 30dp - Always Top-Most Above Sheet) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/floating_caspian_card"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="80dp"
        android:layout_marginEnd="20dp"
        android:elevation="30dp"
        app:cardCornerRadius="26dp"
        app:cardBackgroundColor="#1B4264"
        app:cardElevation="16dp">

        <ImageView
            android:id="@+id/floating_caspian_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launcher_wave"
            android:contentDescription="Caspian Mobile Menu" />
    </androidx.cardview.widget.CardView>

    <!-- 4. Search Navigation Controls (Back / Forward Pill for Google Tabs - Elevation 40dp) -->
    <LinearLayout
        android:id="@+id/search_nav_container"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="90dp"
        android:layout_marginStart="20dp"
        android:elevation="40dp"
        android:background="@drawable/bg_nav_pill"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/nav_back_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF"
            android:contentDescription="Back Navigation" />

        <View
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="#44FFFFFF" />

        <ImageButton
            android:id="@+id/nav_forward_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFFFFF"
            android:contentDescription="Forward Navigation" />
    </LinearLayout>

    <!-- 5. Dictation Audio Wave Screen Overlay View (Elevation 25dp) -->
    <com.caspian.betaa.SpeechWaveformView
        android:id="@+id/speech_waveform_view"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="center_vertical"
        android:elevation="25dp"
        android:visibility="gone" />

    <!-- 4. YouTube-Style Splash Screen Video Overlay (Elevation 50dp) -->
    <FrameLayout
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#050811"
        android:elevation="50dp"
        android:visibility="visible">

        <VideoView
            android:id="@+id/splash_videoview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

</FrameLayout>
