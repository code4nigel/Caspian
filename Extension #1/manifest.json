{
  "manifest_version": 3,
  "name": "ChatGPT Turbo UI",
  "version": "4.0",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://chatgpt.com/*", "*://*.chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "toggle-feature": {
      "suggested_key": {
        "default": "Ctrl+Shift+Alt+Q"
      },
      "description": "Toggle Lag Fixer"
    }
  }
}