<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quick_toolbars_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_caspian_dialog"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <!-- Top Drag Handle -->
    <View
        android:id="@+id/quick_toolbars_drag_handle"
        android:layout_width="44dp"
        android:layout_height="6dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_stitch_handle_bar" />

    <!-- Header: Title + Status + Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Cyan Status Dot -->
            <View
                android:id="@+id/dot_quick_toolbars"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_stitch_dot_inactive"
                android:backgroundTint="#00E5FF" />

            <TextView
                android:id="@+id/text_quick_toolbars_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE DOCKS &amp; TOOLBARS"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Close Button -->
        <ImageButton
            android:id="@+id/btn_close_quick_toolbars"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pod_close"
            android:tint="#94A3B8"
            android:contentDescription="Close" />
    </RelativeLayout>

    <!-- Docks List Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. ChatGPT Dock -->
        <LinearLayout
            android:id="@+id/row_dock_chatgpt"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_menu_item_row"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/squircle_dock_chatgpt"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_stitch_squircle">
                <ImageView
                    android:id="@+id/icon_dock_chatgpt"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_platform_chatgpt"
                    app:tint="#10A37F" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_dock_chatgpt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ChatGPT Dock"
                    android:textColor="#DFE2F0"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sub_dock_chatgpt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dedicated AI sidecar dock"
                    android:textColor="#849396"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_dock_chatgpt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/bg_switch_modern_thumb"
                android:track="@drawable/bg_switch_modern_track"
                app:splitTrack="false"
                app:showText="false"
                app:switchMinWidth="48dp" />
        </LinearLayout>

        <!-- 2. Gemini Dock -->
        <LinearLayout
            android:id="@+id/row_dock_gemini"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_menu_item_row"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/squircle_dock_gemini"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_stitch_squircle">
                <ImageView
                    android:id="@+id/icon_dock_gemini"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_platform_gemini"
                    app:tint="#38BDF8" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_dock_gemini"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gemini Dock"
                    android:textColor="#DFE2F0"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sub_dock_gemini"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Google AI workspace dock"
                    android:textColor="#849396"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_dock_gemini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/bg_switch_modern_thumb"
                android:track="@drawable/bg_switch_modern_track"
                app:splitTrack="false"
                app:showText="false"
                app:switchMinWidth="48dp" />
        </LinearLayout>

        <!-- 3. YouTube Remote -->
        <LinearLayout
            android:id="@+id/row_dock_youtube"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_menu_item_row"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/squircle_dock_youtube"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_stitch_squircle">
                <ImageView
                    android:id="@+id/icon_dock_youtube"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_platform_youtube"
                    app:tint="#EF4444" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_dock_youtube"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YouTube Remote"
                    android:textColor="#DFE2F0"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sub_dock_youtube"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Floating media &amp; playback controls"
                    android:textColor="#849396"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_dock_youtube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/bg_switch_modern_thumb"
                android:track="@drawable/bg_switch_modern_track"
                app:splitTrack="false"
                app:showText="false"
                app:switchMinWidth="48dp" />
        </LinearLayout>

        <!-- 4. Google Dock -->
        <LinearLayout
            android:id="@+id/row_dock_google"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_menu_item_row"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/squircle_dock_google"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_stitch_squircle">
                <ImageView
                    android:id="@+id/icon_dock_google"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_platform_google"
                    app:tint="#4285F4" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_dock_google"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Google Dock"
                    android:textColor="#DFE2F0"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sub_dock_google"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick search &amp; navigation bar"
                    android:textColor="#849396"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_dock_google"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/bg_switch_modern_thumb"
                android:track="@drawable/bg_switch_modern_track"
                app:splitTrack="false"
                app:showText="false"
                app:switchMinWidth="48dp" />
        </LinearLayout>

        <!-- 5. Waveguard Shield -->
        <LinearLayout
            android:id="@+id/row_dock_waveguard"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_menu_item_row"
            android:layout_marginBottom="2dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/squircle_dock_waveguard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_stitch_squircle">
                <ImageView
                    android:id="@+id/icon_dock_waveguard"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_browser_shield"
                    app:tint="#00E5FF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_dock_waveguard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waveguard Shield"
                    android:textColor="#DFE2F0"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sub_dock_waveguard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tracking, ads &amp; telemetry shield"
                    android:textColor="#849396"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_dock_waveguard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/bg_switch_modern_thumb"
                android:track="@drawable/bg_switch_modern_track"
                app:splitTrack="false"
                app:showText="false"
                app:switchMinWidth="48dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
