<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookmarks_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <FrameLayout
            android:id="@+id/bookmarks_header_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0A0E17">

            <ImageButton
                android:id="@+id/btn_bookmarks_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pod_back"
                android:tint="#BAC9CC"
                android:padding="8dp"
                android:scaleType="fitCenter" />

            <!-- Centered Header Carousel Bar: Bookmarks (Count) | History | Settings -->
            <LinearLayout
                android:id="@+id/bookmarks_header_carousel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Active Bookmarks Capsule -->
                <LinearLayout
                    android:id="@+id/capsule_bookmarks_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_stitch_history_entry"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:id="@+id/icon_bookmarks_header"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_menu_bookmark"
                        android:tint="#00E5FF"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/text_bookmarks_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Bookmarks"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badge_bookmarks_header_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_stitch_action_chip"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:text="0"
                        android:textColor="#CBD5E1"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Inactive History Tab -->
                <TextView
                    android:id="@+id/btn_bookmarks_goto_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="History"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Inactive Settings Tab -->
                <TextView
                    android:id="@+id/btn_bookmarks_goto_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Settings"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </FrameLayout>

        <!-- Main Content Area -->
        <ScrollView
            android:id="@+id/bookmarks_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="90dp">

                <!-- Vault Meta Strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/text_vault_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vault"
                        android:textColor="#DFE2F0"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badge_vault_saved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_stitch_action_chip"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="0 SAVED"
                        android:textColor="#00E5FF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- SELECT Toggle Button -->
                    <TextView
                        android:id="@+id/btn_bookmarks_batch_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_stitch_history_entry"
                        android:text="SELECT"
                        android:textColor="#BAC9CC"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Batch Delete Button (Hidden by default, shown when items selected) -->
                    <TextView
                        android:id="@+id/btn_bookmarks_batch_delete"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/bg_stitch_action_chip"
                        android:text="Delete"
                        android:textColor="#FFB4AB"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Search & Sort Filter Bar -->
                <LinearLayout
                    android:id="@+id/bookmarks_search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_stitch_history_search"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/icon_bookmarks_search"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_pod_search"
                        android:tint="#849396"
                        android:scaleType="fitCenter" />

                    <EditText
                        android:id="@+id/bookmarks_search_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Search keywords, domains, tags..."
                        android:textColorHint="#64748B"
                        android:textColor="#DFE2F0"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <!-- Sort Options Button -->
                    <LinearLayout
                        android:id="@+id/btn_bookmarks_sort"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_stitch_history_entry"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/text_bookmarks_sort_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sort"
                            android:textColor="#00E5FF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:text="▼"
                            android:textColor="#849396"
                            android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Filter Chips Horizontal Scroll -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layout_filter_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_filter_all"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:background="@drawable/bg_stitch_chip_active"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="ALL"
                            android:textColor="#000000"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_filter_favorites"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:background="@drawable/bg_stitch_action_chip"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="⭐ FAVORITES"
                            android:textColor="#DFE2F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Bookmarks List Container -->
                <LinearLayout
                    android:id="@+id/bookmarks_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical" />

                <!-- Empty State View -->
                <LinearLayout
                    android:id="@+id/layout_bookmarks_empty"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔖"
                        android:textSize="36sp" />

                    <TextView
                        android:id="@+id/text_bookmarks_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No bookmarks found"
                        android:textColor="#849396"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Floating AI Bottom Action Dock Capsule (EXPORT | + | IMPORT) -->
    <LinearLayout
        android:id="@+id/bookmarks_bottom_dock"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_liquid_glass_pill"
        android:elevation="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- EXPORT Button -->
        <LinearLayout
            android:id="@+id/btn_dock_export"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icon_dock_export"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_menu_share"
                android:tint="#00E5FF"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/text_dock_export"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="EXPORT"
                android:textColor="#DFE2F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center Plus / Create Folder Button -->
        <FrameLayout
            android:id="@+id/btn_dock_add_folder"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_arena_send_circle"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/icon_dock_plus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- IMPORT Button -->
        <LinearLayout
            android:id="@+id/btn_dock_import"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icon_dock_import"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_menu_download"
                android:tint="#00E5FF"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/text_dock_import"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="IMPORT"
                android:textColor="#DFE2F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
