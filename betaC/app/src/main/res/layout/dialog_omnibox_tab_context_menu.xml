<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_caspian_dialog"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_stitch_handle_bar"
        android:layout_marginBottom="14dp" />

    <!-- Tab Info Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_stitch_squircle"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/ctx_tab_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_stitch_globe"
                android:tint="#00E5FF"
                android:contentDescription="Tab Icon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ctx_tab_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tab Title"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/ctx_tab_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="https://example.com"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A2333"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <!-- Action: Close Tab -->
    <LinearLayout
        android:id="@+id/ctx_action_close_tab"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_pod_close"
            android:tint="#F87171"
            android:layout_marginEnd="14dp"
            android:contentDescription="Close" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Close Tab"
            android:textColor="#F87171"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action: Close Other Tabs -->
    <LinearLayout
        android:id="@+id/ctx_action_close_others"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_stitch_trash"
            android:tint="#94A3B8"
            android:layout_marginEnd="14dp"
            android:contentDescription="Close Others" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Close Other Tabs"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action: Duplicate Tab -->
    <LinearLayout
        android:id="@+id/ctx_action_duplicate"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_arena_plus"
            android:tint="#38BDF8"
            android:layout_marginEnd="14dp"
            android:contentDescription="Duplicate" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Duplicate Tab"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action: Split Screen -->
    <LinearLayout
        android:id="@+id/ctx_action_split_screen"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_browser_split"
            android:tint="#00E5FF"
            android:layout_marginEnd="14dp"
            android:contentDescription="Split Screen" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Open in Split Screen"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action: Exit Split Screen -->
    <LinearLayout
        android:id="@+id/ctx_action_split_exit"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_pod_close"
            android:tint="#F87171"
            android:layout_marginEnd="14dp"
            android:contentDescription="Exit Split" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Exit Split Screen"
            android:textColor="#F87171"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action: Swap Split Sides -->
    <LinearLayout
        android:id="@+id/ctx_action_split_swap"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_browser_split"
            android:tint="#38BDF8"
            android:layout_marginEnd="14dp"
            android:contentDescription="Swap Split" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Swap Split Sides"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action: Move to Cask / Container -->
    <LinearLayout
        android:id="@+id/ctx_action_move_cask"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_menu_bookmark"
            android:tint="#A78BFA"
            android:layout_marginEnd="14dp"
            android:contentDescription="Move to Cask" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Move to Container / Cask"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action: Move to Tab Group -->
    <LinearLayout
        android:id="@+id/ctx_action_move_tab_group"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_browser_tabs"
            android:tint="#10B981"
            android:layout_marginEnd="14dp"
            android:contentDescription="Move to Group" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Move to Tab Group"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action: Make a Tab Group -->
    <LinearLayout
        android:id="@+id/ctx_action_make_tab_group"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_arena_plus"
            android:tint="#00E5FF"
            android:layout_marginEnd="14dp"
            android:contentDescription="Make Tab Group" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Make a Tab Group"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action: Share Tab -->
    <LinearLayout
        android:id="@+id/ctx_action_share"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_menu_share"
            android:tint="#94A3B8"
            android:layout_marginEnd="14dp"
            android:contentDescription="Share" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Share Link"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action: Copy URL -->
    <LinearLayout
        android:id="@+id/ctx_action_copy_url"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_pod_search"
            android:tint="#94A3B8"
            android:layout_marginEnd="14dp"
            android:contentDescription="Copy URL" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Copy Tab URL"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
