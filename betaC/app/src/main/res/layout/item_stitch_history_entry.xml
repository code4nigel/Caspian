<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/history_entry_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_stitch_history_entry"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar Container -->
    <FrameLayout
        android:id="@+id/history_item_avatar_container"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_stitch_squircle"
        android:backgroundTint="#0D1117">

        <ImageView
            android:id="@+id/history_item_favicon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_stitch_globe"
            android:tint="#849396" />

        <TextView
            android:id="@+id/history_item_initial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Title & URL Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/history_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Page Title"
            android:textColor="#DFE2F0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/history_item_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="domain.com/path"
            android:textColor="#849396"
            android:textSize="10.5sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Time & 3-Dots Action -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/history_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18:59"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/history_item_btn_actions"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_stitch_more_vert"
            android:tint="#849396"
            android:scaleType="centerInside"
            android:contentDescription="Item Actions" />
    </LinearLayout>

</LinearLayout>
