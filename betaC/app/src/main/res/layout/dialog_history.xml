<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:orientation="vertical">

    <!-- Top Sticky Header Section -->
    <LinearLayout
        android:id="@+id/history_header_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0A0E17"
        android:paddingBottom="8dp">

        <!-- Header Carousel Bar: Bookmarks | History (Count) | Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tab_header_bookmarks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bookmarks"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <!-- Active History Capsule -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_stitch_history_entry"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge_history_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_stitch_action_chip"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="0"
                    android:textColor="#CBD5E1"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tab_header_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Integrated Search + Action Controls Capsule -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_stitch_history_search"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <!-- Search Icon -->
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_pod_search"
                android:tint="#64748B"
                android:contentDescription="Search" />

            <!-- Search Input -->
            <EditText
                android:id="@+id/history_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:hint="Start search history"
                android:textColorHint="#64748B"
                android:textColor="#F1F5F9"
                android:textSize="12.5sp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="#1E2433"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp" />

            <!-- Action Controls: Select, More, Close -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btn_history_select"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_stitch_bottom_action_primary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="Select"
                    android:textColor="#E2E8F0"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/btn_history_options"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_stitch_bottom_action_primary"
                    android:src="@drawable/ic_stitch_more_vert"
                    android:tint="#94A3B8"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Options" />

                <ImageView
                    android:id="@+id/history_close_btn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_stitch_bottom_action_primary"
                    android:src="@drawable/ic_pod_close"
                    android:tint="#94A3B8"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Close" />
            </LinearLayout>
        </LinearLayout>

        <!-- Time Horizon Filter Chips Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:layout_marginTop="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chip_filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_stitch_chip_active"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="All Entries"
                    android:textColor="#0F172A"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_filter_1h"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_stitch_chip_inactive"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="● Last 1 Hour"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_filter_24h"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_stitch_chip_inactive"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="Last 24 Hours"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chip_filter_1w"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_stitch_chip_inactive"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="Last 1 Week"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E2433"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- History List ScrollView -->
    <ScrollView
        android:id="@+id/history_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/history_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />
    </ScrollView>

    <!-- Empty State View -->
    <TextView
        android:id="@+id/history_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No browsing history yet"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Clean Matte Bottom Toolbar -->
    <LinearLayout
        android:id="@+id/history_bottom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:paddingTop="4dp"
        android:background="#0A0E17">

        <!-- Matte Container Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_stitch_history_bottom_bar"
            android:padding="10dp">

            <!-- Normal Toolbar Mode -->
            <LinearLayout
                android:id="@+id/bottom_normal_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Time Range Dropdown Center Row -->
                <LinearLayout
                    android:id="@+id/layout_time_range_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_stitch_clock"
                        android:tint="#94A3B8"
                        android:contentDescription="Time" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time Range:"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:layout_marginStart="6dp" />

                    <!-- Custom Dropdown Pill -->
                    <LinearLayout
                        android:id="@+id/pill_time_range_dropdown"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_stitch_bottom_action_btn"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/text_selected_time_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last 24 Hours"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_menu_chevron_down"
                            android:tint="#94A3B8" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Action Buttons: Clear Cookies | Clear Data | Clear Both -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <LinearLayout
                        android:id="@+id/btn_clear_cookies"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stitch_bottom_action_btn"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_stitch_cookie"
                            android:tint="#94A3B8"
                            android:contentDescription="Cookies" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Clear Cookies"
                            android:textColor="#CBD5E1"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_clear_data"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stitch_bottom_action_primary"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_stitch_trash"
                            android:tint="#FFFFFF"
                            android:contentDescription="Data" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Clear Data"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_clear_both"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stitch_bottom_action_btn"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_stitch_refresh"
                            android:tint="#94A3B8"
                            android:contentDescription="Both" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Clear Both"
                            android:textColor="#CBD5E1"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Multi-Select Action Bar (shown when select mode is active) -->
            <LinearLayout
                android:id="@+id/bottom_select_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/text_selected_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 selected"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_select_all_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_stitch_bottom_action_btn"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Select All"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_delete_selected"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_stitch_bottom_action_primary"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Delete"
                    android:textColor="#F87171"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_cancel_select"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_stitch_bottom_action_btn"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Cancel"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
