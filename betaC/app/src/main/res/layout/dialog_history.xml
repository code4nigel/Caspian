<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2050811"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📜 Browsing History"
            android:textColor="#DFE2F0"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/history_close_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pod_close"
            android:tint="#BAC9CC"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="Close History" />
    </LinearLayout>

    <!-- Search History Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_omnibox_capsule"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_pod_search"
            android:tint="#849396" />

        <EditText
            android:id="@+id/history_search_input"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:hint="Search history..."
            android:textColorHint="#849396"
            android:textColor="#DFE2F0"
            android:textSize="13sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Selective Clear Action Chips Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_clear_history_1h"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_liquid_glass_pill"
                android:text="🧹 Last 1 Hour"
                android:textColor="#DFE2F0"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_clear_history_24h"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_liquid_glass_pill"
                android:text="🧹 Last 24 Hours"
                android:textColor="#DFE2F0"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_clear_history_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_liquid_glass_pill"
                android:text="🗑️ Clear All"
                android:textColor="#FF6B6B"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_clear_cookies"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_liquid_glass_pill"
                android:text="🍪 Clear Cookies"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- History Items List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/history_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Empty State -->
    <TextView
        android:id="@+id/history_empty_view"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="No browsing history yet"
        android:textColor="#849396"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
