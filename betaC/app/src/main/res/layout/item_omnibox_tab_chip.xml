<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/omnibox_tab_chip_root"
    android:layout_width="wrap_content"
    android:layout_height="28dp"
    android:minWidth="90dp"
    android:maxWidth="160dp"
    android:layout_marginEnd="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="4dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/omnibox_tab_icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_stitch_globe"
        android:tint="#38BDF8"
        android:contentDescription="Tab Icon" />

    <TextView
        android:id="@+id/omnibox_tab_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textColor="#94A3B8"
        android:text="New Tab" />

    <FrameLayout
        android:id="@+id/omnibox_tab_close_btn"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Close Tab">

        <ImageView
            android:id="@+id/omnibox_tab_close_icon"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pod_close"
            android:tint="#64748B" />
    </FrameLayout>
</LinearLayout>
