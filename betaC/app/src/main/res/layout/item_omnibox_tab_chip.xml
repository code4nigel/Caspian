<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/omnibox_tab_chip_root"
    android:layout_width="130dp"
    android:layout_height="33dp"
    android:layout_marginEnd="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="4dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/omnibox_tab_icon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginEnd="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_stitch_globe"
        android:contentDescription="Tab Icon" />

    <TextView
        android:id="@+id/omnibox_tab_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="11.5sp"
        android:textColor="#94A3B8"
        android:text="New Tab" />

    <FrameLayout
        android:id="@+id/omnibox_tab_close_btn"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Close Tab">

        <ImageView
            android:id="@+id/omnibox_tab_close_icon"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pod_close"
            android:tint="#64748B" />
    </FrameLayout>
</LinearLayout>
