<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/action_grid_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_caspian_dialog"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="16dp">

    <!-- Top Drag Handle -->
    <View
        android:id="@+id/action_grid_drag_handle"
        android:layout_width="44dp"
        android:layout_height="6dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_stitch_handle_bar" />

    <!-- Header: Caspian Menu Title + Version Pill Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Green Status Dot -->
            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_stitch_dot_inactive"
                android:backgroundTint="#10B981" />

            <TextView
                android:id="@+id/text_menu_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CASPIAN MENU"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Version Badge Pill -->
        <TextView
            android:id="@+id/badge_app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_stitch_badge_version"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="v1.2.81-BetaC"
            android:textColor="#38BDF8"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- 2-Page Swipeable ViewFlipper Carousel for Action Grid -->
    <com.caspian.betac.SwipeableViewFlipper
        android:id="@+id/action_grid_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Page 1: Primary Essentials (5 Columns x 2 Rows + Cask Pill Bar) -->
        <LinearLayout
            android:id="@+id/action_grid_page1_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TableLayout
                android:id="@+id/action_grid_page1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0,1,2,3,4">

            <!-- Row 1 -->
            <TableRow android:layout_marginBottom="12dp">
                <!-- 1. Night Mode -->
                <LinearLayout
                    android:id="@+id/tile_night_mode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout
                        android:id="@+id/squircle_night_mode"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stitch_squircle">
                        <ImageView
                            android:id="@+id/icon_night_mode"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_moon"
                            android:tint="#DFE2F0" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/text_night_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Night mode"
                        android:textColor="#DFE2F0"
                        android:textSize="10.5sp"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 2. Desktop Site -->
                <LinearLayout
                    android:id="@+id/tile_desktop_site"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout
                        android:id="@+id/squircle_desktop_site"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stitch_squircle">
                        <ImageView
                            android:id="@+id/icon_desktop_site"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_browser_desktop"
                            android:tint="#DFE2F0" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/text_desktop_site"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Desktop site"
                        android:textColor="#DFE2F0"
                        android:textSize="10.5sp"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 3. Bookmarks -->
                <LinearLayout
                    android:id="@+id/tile_bookmarks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout
                        android:id="@+id/squircle_bookmarks"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stitch_squircle">
                        <ImageView
                            android:id="@+id/icon_bookmarks"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_bookmark"
                            android:tint="#DFE2F0" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/text_bookmarks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Save Bookmark"
                        android:textColor="#DFE2F0"
                        android:textSize="10.5sp"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 4. History -->
                <LinearLayout
                    android:id="@+id/tile_history"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout
                        android:id="@+id/squircle_history"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stitch_squircle">
                        <ImageView
                            android:id="@+id/icon_history"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_history"
                            android:tint="#DFE2F0" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/text_history"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="History"
                        android:textColor="#DFE2F0"
                        android:textSize="10.5sp"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 5. Downloads (with notification badge dot) -->
                <LinearLayout
                    android:id="@+id/tile_downloads"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout
                        android:id="@+id/squircle_downloads"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stitch_squircle">
                        <ImageView
                            android:id="@+id/icon_downloads"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_download"
                            android:tint="#DFE2F0" />
                        <!-- Green active badge dot (hidden by default) -->
                        <View
                            android:id="@+id/badge_dot_downloads"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_stitch_dot_inactive"
                            android:backgroundTint="#10B981"
                            android:visibility="gone" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/text_downloads"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Downloads"
                        android:textColor="#DFE2F0"
                        android:textSize="10.5sp"
                        android:singleLine="true" />
                </LinearLayout>
            </TableRow>

            <!-- Row 2 -->
            <TableRow>
                <!-- 6. Incognito Mode -->
                <LinearLayout
                    android:id="@+id/tile_incognito"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout
                        android:id="@+id/squircle_incognito"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stitch_squircle">
                        <ImageView
                            android:id="@+id/icon_incognito"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_incognito"
                            android:tint="#DFE2F0" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/text_incognito"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Incognito"
                        android:textColor="#DFE2F0"
                        android:textSize="10.5sp"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 7. Find in Page -->
                <LinearLayout
                    android:id="@+id/tile_find"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout
                        android:id="@+id/squircle_find"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stitch_squircle">
                        <ImageView
                            android:id="@+id/icon_find"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_pod_search"
                            android:tint="#DFE2F0" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/text_find"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Find in page"
                        android:textColor="#DFE2F0"
                        android:textSize="10.5sp"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 8. Share -->
                <LinearLayout
                    android:id="@+id/tile_share"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout
                        android:id="@+id/squircle_share"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stitch_squircle">
                        <ImageView
                            android:id="@+id/icon_share"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_share"
                            android:tint="#DFE2F0" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/text_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Share"
                        android:textColor="#DFE2F0"
                        android:textSize="10.5sp"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 9. Split Screen -->
                <LinearLayout
                    android:id="@+id/tile_split"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout
                        android:id="@+id/squircle_split"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stitch_squircle">
                        <ImageView
                            android:id="@+id/icon_split"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_browser_split"
                            android:tint="#DFE2F0" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/text_split"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Split screen"
                        android:textColor="#DFE2F0"
                        android:textSize="10.5sp"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 10. Settings (Featured Accent Cyan) -->
                <LinearLayout
                    android:id="@+id/tile_settings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout
                        android:id="@+id/squircle_settings"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stitch_squircle_active">
                        <ImageView
                            android:id="@+id/icon_settings"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_pod_settings"
                            android:tint="#00E5FF" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/text_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Settings"
                        android:textColor="#00E5FF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:singleLine="true" />
                </LinearLayout>
            </TableRow>
        </TableLayout>

            <!-- Interactive Caspian Cask Pill Bar -->
            <LinearLayout
                android:id="@+id/widget_grid_cask_bar"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_stitch_squircle"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/icon_grid_cask"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:text="🌊"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/text_grid_cask_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Caspian Cask: "
                        android:textColor="#94A3B8"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_grid_cask_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="General"
                        android:textColor="#00E5FF"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Switch Button Pill -->
                <LinearLayout
                    android:id="@+id/btn_grid_cask_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_stitch_zoom_stepper"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/icon_grid_cask_switch"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_tab_globe"
                        android:tint="#00E5FF" />

                    <TextView
                        android:id="@+id/text_grid_cask_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Switch"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Page 2: Power Tools & Interactive Controls -->
        <LinearLayout
            android:id="@+id/action_grid_page2_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TableLayout
                android:id="@+id/action_grid_page2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0,1,2,3">

                <!-- Row 1: New Tab, Dual AI, Open PDF, Print & Export -->
                <TableRow android:layout_marginBottom="12dp">
                    <!-- 1. New Tab -->
                    <LinearLayout
                        android:id="@+id/tile_new_tab"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <FrameLayout
                            android:id="@+id/squircle_new_tab"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_stitch_squircle">
                            <ImageView
                                android:id="@+id/icon_new_tab"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_browser_tabs"
                                android:tint="#DFE2F0" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/text_new_tab"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="New tab"
                            android:textColor="#DFE2F0"
                            android:textSize="10.5sp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- 2. Dual AI -->
                    <LinearLayout
                        android:id="@+id/tile_dual_ai"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <FrameLayout
                            android:id="@+id/squircle_dual_ai"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_stitch_squircle_active">
                            <ImageView
                                android:id="@+id/icon_dual_ai"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_arena_plus"
                                android:tint="#00E5FF" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/text_dual_ai"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Dual AI"
                            android:textColor="#00E5FF"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- 3. Open PDF -->
                    <LinearLayout
                        android:id="@+id/tile_pdf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <FrameLayout
                            android:id="@+id/squircle_pdf"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_stitch_squircle">
                            <ImageView
                                android:id="@+id/icon_pdf"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_menu_pdf"
                                android:tint="#FB7185" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/text_pdf"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Open PDF"
                            android:textColor="#DFE2F0"
                            android:textSize="10.5sp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- 4. Print & Export -->
                    <LinearLayout
                        android:id="@+id/tile_print"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <FrameLayout
                            android:id="@+id/squircle_print"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_stitch_squircle">
                            <ImageView
                                android:id="@+id/icon_print"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_menu_print"
                                android:tint="#DFE2F0" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/text_print"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Print &amp; Export"
                            android:textColor="#DFE2F0"
                            android:textSize="10.5sp"
                            android:singleLine="true" />
                    </LinearLayout>
                </TableRow>

                <!-- Row 2: Waveguard, Clear Data, Edit Menu -->
                <TableRow>
                    <!-- 5. Waveguard Shield -->
                    <LinearLayout
                        android:id="@+id/tile_shield"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <FrameLayout
                            android:id="@+id/squircle_shield"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_stitch_squircle">
                            <ImageView
                                android:id="@+id/icon_shield"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_browser_shield"
                                android:tint="#10B981" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/text_shield"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Waveguard"
                            android:textColor="#DFE2F0"
                            android:textSize="10.5sp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- 6. Clear Data -->
                    <LinearLayout
                        android:id="@+id/tile_clear_data"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <FrameLayout
                            android:id="@+id/squircle_clear_data"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_stitch_squircle">
                            <ImageView
                                android:id="@+id/icon_clear_data"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_pod_close"
                                android:tint="#FF6B6B" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/text_clear_data"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Clear data"
                            android:textColor="#FF6B6B"
                            android:textSize="10.5sp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- 7. Edit Menu Layout -->
                    <LinearLayout
                        android:id="@+id/tile_edit_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <FrameLayout
                            android:id="@+id/squircle_edit_layout"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_stitch_squircle">
                            <ImageView
                                android:id="@+id/icon_edit_layout"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_menu_edit"
                                android:tint="#38BDF8" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/text_edit_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Edit menu"
                            android:textColor="#38BDF8"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- 8. View Bookmarks -->
                    <LinearLayout
                        android:id="@+id/tile_view_bookmarks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <FrameLayout
                            android:id="@+id/squircle_view_bookmarks"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_stitch_squircle">
                            <ImageView
                                android:id="@+id/icon_view_bookmarks"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_menu_bookmark"
                                android:tint="#38BDF8" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/text_view_bookmarks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Bookmarks"
                            android:textColor="#DFE2F0"
                            android:textSize="10.5sp"
                            android:singleLine="true" />
                    </LinearLayout>
                </TableRow>
            </TableLayout>

            <!-- Interactive Page Zoom Stepper Bar -->
            <LinearLayout
                android:id="@+id/widget_grid_zoom_stepper"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_stitch_squircle"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/icon_grid_zoom"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_menu_zoom"
                    android:tint="#94A3B8" />

                <TextView
                    android:id="@+id/text_grid_zoom_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Page Zoom"
                    android:textColor="#DFE2F0"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- Stepper Capsule with Minus, Zoom %, Plus -->
                <LinearLayout
                    android:id="@+id/capsule_grid_zoom_stepper"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_stitch_zoom_stepper"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/btn_grid_zoom_minus"
                        android:layout_width="26dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="－"
                        android:textColor="#DFE2F0"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/text_grid_zoom_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="100%"
                        android:textColor="#00E5FF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_grid_zoom_plus"
                        android:layout_width="26dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="＋"
                        android:textColor="#DFE2F0"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Reset to 100% Button -->
                    <ImageView
                        android:id="@+id/btn_grid_zoom_reset"
                        android:layout_width="26dp"
                        android:layout_height="match_parent"
                        android:padding="6dp"
                        android:src="@drawable/ic_pod_reload"
                        android:tint="#00E5FF"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Reset Zoom" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.caspian.betac.SwipeableViewFlipper>

    <!-- Carousel Indicator (Pill + Dot) -->
    <LinearLayout
        android:id="@+id/action_grid_dots_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/pill_dot_page1"
            android:layout_width="18dp"
            android:layout_height="6dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/bg_stitch_pill_active" />

        <View
            android:id="@+id/pill_dot_page2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_stitch_dot_inactive" />
    </LinearLayout>

    <!-- Bottom Utility Bar: Power Exit (Left) + Waveguard Capsule (Center) + Chevron Close (Right) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="2dp">

        <!-- Power / Close Session Button -->
        <ImageButton
            android:id="@+id/btn_action_exit_app"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_stitch_round_button"
            android:src="@drawable/ic_menu_power"
            android:tint="#DFE2F0"
            android:contentDescription="Exit App" />

        <!-- Centered Waveguard Status Capsule -->
        <LinearLayout
            android:id="@+id/waveguard_status_capsule"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_stitch_waveguard_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icon_waveguard_capsule"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_browser_shield"
                android:tint="#10B981" />

            <TextView
                android:id="@+id/waveguard_capsule_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waveguard"
                android:textColor="#DFE2F0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="•"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/waveguard_capsule_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="142 blocked"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Chevron Down Close Sheet Button -->
        <ImageButton
            android:id="@+id/btn_action_close_grid"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_stitch_round_button"
            android:src="@drawable/ic_menu_chevron_down"
            android:tint="#DFE2F0"
            android:contentDescription="Close Menu" />
    </RelativeLayout>

</LinearLayout>
