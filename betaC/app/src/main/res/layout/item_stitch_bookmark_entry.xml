<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookmark_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_stitch_history_entry"
    android:clickable="true"
    android:focusable="true">

    <!-- Batch Select Checkbox (hidden by default) -->
    <CheckBox
        android:id="@+id/bookmark_item_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />

    <!-- Leading Icon / Squircle -->
    <FrameLayout
        android:id="@+id/bookmark_item_icon_frame"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_stitch_action_chip">

        <ImageView
            android:id="@+id/bookmark_item_favicon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bookmark_item_emoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🔖"
            android:textSize="18sp" />
    </FrameLayout>

    <!-- Center Info Block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title Row with Tag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/bookmark_item_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bookmark Title"
                android:textColor="#DFE2F0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/bookmark_item_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_stitch_badge_version"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="DEV"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Domain and Timestamp Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/bookmark_item_domain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="notion.so/caspian"
                android:textColor="#849396"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <View
                android:id="@+id/bookmark_item_dot"
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_stitch_dot_inactive" />

            <TextView
                android:id="@+id/bookmark_item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2d ago"
                android:textColor="#4EDEA3"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Controls: Star & More -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="8dp">

        <ImageButton
            android:id="@+id/bookmark_item_star"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu_bookmark"
            android:tint="#FEC931"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/bookmark_item_more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu_edit"
            android:tint="#849396"
            android:padding="6dp"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
