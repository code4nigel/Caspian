<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ON: Translucent glowing cyan capsule with electric cyan border -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="46dp" android:height="26dp" />
            <corners android:radius="13dp" />
            <solid android:color="#2600E5FF" />
            <stroke android:width="1.2dp" android:color="#00E5FF" />
        </shape>
    </item>
    <!-- OFF: Dark obsidian recessed capsule with neutral slate border -->
    <item>
        <shape android:shape="rectangle">
            <size android:width="46dp" android:height="26dp" />
            <corners android:radius="13dp" />
            <solid android:color="#141D27" />
            <stroke android:width="1.2dp" android:color="#2A3748" />
        </shape>
    </item>
</selector>
