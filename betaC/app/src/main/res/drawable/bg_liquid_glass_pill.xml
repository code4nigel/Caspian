<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop Shadow / Ambient Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9999dp" />
            <solid android:color="#26000000" />
        </shape>
    </item>
    <!-- Base Frosted Tint -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="9999dp" />
            <solid android:color="@color/caspian_glass_low" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
    <!-- Top Edge Specular Reflection (Light Catcher) -->
    <item android:bottom="46dp" android:left="12dp" android:right="12dp">
        <shape android:shape="rectangle">
            <corners android:radius="9999dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="@color/caspian_specular_top"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
