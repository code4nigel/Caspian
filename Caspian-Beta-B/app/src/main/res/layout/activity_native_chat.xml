<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050811">

    <!-- MAIN CONTENT VIEW -->
    <RelativeLayout
        android:id="@+id/root_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. Top Header Bar -->
        <LinearLayout
            android:id="@+id/top_header_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_alignParentTop="true"
            android:background="#0d1424"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:elevation="6dp">

            <!-- Sidebar Drawer Toggle Button (≡) -->
            <ImageButton
                android:id="@+id/btn_open_history"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="History Drawer"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#FFFFFF" />

            <!-- App Title & Live Auth Status -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CASPIAN BETA B"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tv_auth_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Ready (Public Session)"
                    android:textColor="#10b981"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Sign In Web Drawer Button -->
            <TextView
                android:id="@+id/btn_sign_in_web"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_model_active"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Sign In"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Dynamic Model Selector Button -->
            <LinearLayout
                android:id="@+id/btn_model_selector"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_model_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_current_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Models ▾"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Native RecyclerView Message Container -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_header_bar"
            android:layout_above="@id/bottom_input_dock"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 3. Bottom Input Dock with Voice Mic & Attachment -->
        <LinearLayout
            android:id="@+id/bottom_input_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#0d1424"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:elevation="8dp">

            <ImageButton
                android:id="@+id/btn_attach"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Attach File"
                android:src="@android:drawable/ic_menu_add"
                app:tint="#A2A9A9" />

            <EditText
                android:id="@+id/et_native_prompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_native_input"
                android:hint="Type message to AI..."
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:maxLines="4"
                android:inputType="textMultiLine|textCapSentences" />

            <!-- Voice Mic Button -->
            <ImageButton
                android:id="@+id/btn_voice_mic"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voice Typing"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="#A2A9A9" />

            <!-- Send Button -->
            <ImageButton
                android:id="@+id/btn_native_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_send_btn"
                android:contentDescription="Send Message"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- 4. Overlay Control Sheet Container -->
        <FrameLayout
            android:id="@+id/sheet_overlay_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:elevation="20dp">

            <View
                android:id="@+id/sheet_backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#88000000" />

            <WebView
                android:id="@+id/control_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />
        </FrameLayout>

        <!-- 5. Visible Web Auth Sheet Container (For Google / OpenAI Login) -->
        <FrameLayout
            android:id="@+id/web_auth_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:elevation="25dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#0D1424">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="#050811">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Web Authentication Sheet"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_close_auth_sheet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Done ✖"
                        android:textColor="#10B981"
                        android:textStyle="bold"
                        android:padding="8dp" />
                </LinearLayout>

                <WebView
                    android:id="@+id/auth_sheet_webview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>
        </FrameLayout>

        <!-- 6. Floating Caspian Card (Elevation 99dp - ABSOLUTE TOP ORDER) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/floating_caspian_card"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentEnd="true"
            android:layout_above="@id/bottom_input_dock"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="99dp"
            app:cardCornerRadius="26dp"
            app:cardBackgroundColor="#1B4264">

            <ImageView
                android:id="@+id/floating_caspian_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher_wave"
                android:contentDescription="Caspian Mobile Menu" />
        </androidx.cardview.widget.CardView>

    </RelativeLayout>

    <!-- LEFT SIDEBAR DRAWER (CHAT HISTORY & SEARCH) -->
    <LinearLayout
        android:id="@+id/left_drawer_container"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0d1424"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conversation History"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/et_search_history"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_native_input"
            android:hint="Search past chats..."
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/btn_new_chat"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_model_active"
            android:gravity="center"
            android:text="+ New Conversation"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
