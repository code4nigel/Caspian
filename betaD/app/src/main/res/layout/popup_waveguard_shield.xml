<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#131922"
    app:cardCornerRadius="18dp"
    app:cardElevation="14dp"
    app:cardMaxElevation="16dp"
    app:cardPreventCornerOverlap="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Brand & Status Pill -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/brand_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/shield_logo"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_browser_shield"
                    app:tint="#00E5FF" />

                <TextView
                    android:id="@+id/shield_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="WAVEGUARD"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <TextView
                android:id="@+id/shield_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="#2000E5FF"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="PROTECTED"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Current Site Info -->
        <TextView
            android:id="@+id/current_site_domain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="sans-serif-light"
            android:singleLine="true"
            android:text="example.com"
            android:textColor="#9EABB8"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- Master Switch: Shields UP on this site -->
        <RelativeLayout
            android:id="@+id/site_shield_toggle_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A222F"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/site_shield_switch"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/site_shield_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shields UP on this site"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/site_shield_sublabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Block tracking, ads, and telemetry"
                    android:textColor="#7A8999"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/site_shield_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true"
                app:thumbTint="#00E5FF"
                app:trackTint="#3300E5FF" />
        </RelativeLayout>

        <!-- Stats Counter Panel -->
        <LinearLayout
            android:id="@+id/stats_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161F2B"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/blocked_count_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#3000E5FF"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="0"
                android:textColor="#00E5FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Threats &amp; Ads Blocked"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/blocked_total_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 blocked all-time across tabs"
                    android:textColor="#667788"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Granular Controls Divider / Section Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADVANCED DEFENSE"
            android:textColor="#556575"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <!-- Switch 1: Ads & Trackers -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Cross-Site Trackers &amp; Ads"
                android:textColor="#D0D7DE"
                android:textSize="12sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_adblock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true"
                app:thumbTint="#00E5FF"
                app:trackTint="#3300E5FF" />
        </RelativeLayout>

        <!-- Switch 2: Cosmetic Element Hiding -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Cosmetic Element Hiding"
                android:textColor="#D0D7DE"
                android:textSize="12sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_cosmetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true"
                app:thumbTint="#00E5FF"
                app:trackTint="#3300E5FF" />
        </RelativeLayout>

        <!-- Switch 3: Anti-Adblock Defuser -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Anti-Adblock Defuser"
                android:textColor="#D0D7DE"
                android:textSize="12sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_defuser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true"
                app:thumbTint="#00E5FF"
                app:trackTint="#3300E5FF" />
        </RelativeLayout>

        <!-- Switch 4: Aggressive Popups & Redirects -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Block Popups &amp; Redirects"
                android:textColor="#D0D7DE"
                android:textSize="12sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_popups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true"
                app:thumbTint="#00E5FF"
                app:trackTint="#3300E5FF" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#222C38"
            android:layout_marginBottom="8dp" />

        <!-- Footer: Rule status & Update Rules button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/rules_version_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Waveguard v2.4 (227 rules)"
                android:textColor="#556575"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btn_update_rules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp"
                android:text="Update Lists"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
